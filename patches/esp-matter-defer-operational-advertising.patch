+void TryAdvertiseOperational()
+{
+    CHIP_ERROR err = chip::app::DnssdServer::Instance().AdvertiseOperational();
+    if (err == CHIP_NO_ERROR)
+    {
+        gOperationalAdvertisementRetries = 0;
+        ChipLogProgress(AppServer, "Operational advertising enabled");
+        return;
+    }
+
+    if (err == CHIP_ERROR_INCORRECT_STATE && gOperationalAdvertisementRetries < kMaxOperationalAdvertisementRetries)
+    {
+        gOperationalAdvertisementRetries++;
+        ChipLogProgress(AppServer, "Operational advertising deferred until DNS-SD advertiser is initialized");
+        CHIP_ERROR timerErr = chip::DeviceLayer::SystemLayer().StartTimer(kOperationalAdvertisementRetryDelay,
+                                                                          [](chip::System::Layer *, void *) {
+                                                                              TryAdvertiseOperational();
+                                                                          },
+                                                                          nullptr);
+        if (timerErr != CHIP_NO_ERROR)
+        {
+            ChipLogError(AppServer, "Operational advertising retry timer failed: %" CHIP_ERROR_FORMAT, timerErr.Format());
+        }
+        return;
+    }
+
+    gOperationalAdvertisementRetries = 0;
+    ChipLogError(AppServer, "Operational advertising failed: %" CHIP_ERROR_FORMAT, err.Format());
 }
